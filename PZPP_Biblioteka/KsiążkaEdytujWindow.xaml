<Window x:Class="PZPP_Biblioteka.KsiążkaEdytujWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj Książkę" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15" Background="#f0f7f4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Edytuj książkę"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="#1a5c42"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Tytuł:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding SelectedKsiążka.Tytuł, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,3" Padding="5,4"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Autor:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Autorzy}"
                  DisplayMemberPath="PełneNazwisko"
                  SelectedItem="{Binding WybranyAutor, Mode=TwoWay}"
                  Margin="0,3" Padding="5,4"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Gatunek:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding Gatunki}"
                  DisplayMemberPath="Nazwa"
                  SelectedItem="{Binding WybranyGatunek, Mode=TwoWay}"
                  Margin="0,3" Padding="5,4"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Ilość na stanie:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding SelectedKsiążka.IloscNaStanie, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,3" Padding="5,4"/>

        <Label Grid.Row="5" Grid.Column="0" Content="ISBN:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1"
                 Text="{Binding SelectedKsiążka.ISBN, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,3" Padding="5,4"/>

        <Button Grid.Row="7" Grid.ColumnSpan="2"
                Content="Zapisz zmiany"
                Command="{Binding ZapiszKsiążkaCommand}"
                HorizontalAlignment="Right" Width="130" Height="32"
                Background="#2e7d5e" Foreground="White"
                FontWeight="Bold" BorderThickness="0" Margin="0,10,0,0"/>
    </Grid>
</Window>