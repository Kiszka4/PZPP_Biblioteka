<Window x:Class="PZPP_Biblioteka.KsiążkaEdytujWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj Książkę" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#f0f7f4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2e7d5e" Padding="15,10">
            <TextBlock Text="✏️ Edytuj książkę" Foreground="White"
                       FontSize="15" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="15,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Tytuł:"
                   Foreground="#1a3d2b" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding SelectedKsiążka.Tytuł, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3" Padding="6,5" BorderBrush="#b2d8c8" BorderThickness="1"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Autor:"
                   Foreground="#1a3d2b" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding Autorzy}"
                      DisplayMemberPath="PełneNazwisko"
                      SelectedItem="{Binding WybranyAutor, Mode=TwoWay}"
                      Margin="0,3" Padding="6,4"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Gatunek:"
                   Foreground="#1a3d2b" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Gatunki}"
                      DisplayMemberPath="Nazwa"
                      SelectedItem="{Binding WybranyGatunek, Mode=TwoWay}"
                      Margin="0,3" Padding="6,4"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Ilość na stanie:"
                   Foreground="#1a3d2b" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding SelectedKsiążka.IloscNaStanie, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3" Padding="6,5" BorderBrush="#b2d8c8" BorderThickness="1"/>

            <Label Grid.Row="4" Grid.Column="0" Content="ISBN:"
                   Foreground="#1a3d2b" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding SelectedKsiążka.ISBN, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3" Padding="6,5" BorderBrush="#b2d8c8" BorderThickness="1"/>
        </Grid>

        <Border Grid.Row="2" Background="#2e7d5e" Padding="10,8">
            <Button Content="Zapisz zmiany"
                    Command="{Binding ZapiszKsiążkaCommand}"
                    HorizontalAlignment="Right" Width="120" Height="30"
                    Background="#4caf50" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>