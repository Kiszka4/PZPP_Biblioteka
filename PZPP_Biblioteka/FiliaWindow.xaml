<Window x:Class="PZPP_Biblioteka.FiliaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzaj Filiami" Height="450" Width="500">
    <Grid Background="#f5faf7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2e7d5e" Padding="15,10">
            <TextBlock Text="🏛️ Filie Biblioteki" Foreground="White"
                       FontSize="18" FontWeight="Bold"/>
        </Border>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Filie}"
                  SelectedItem="{Binding SelectedFilia, Mode=TwoWay}"
                  Background="#f5faf7" BorderThickness="0" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" Width="50"/>
                    <GridViewColumn Header="Nazwa" DisplayMemberBinding="{Binding Nazwa}" Width="180"/>
                    <GridViewColumn Header="Lokalizacja" DisplayMemberBinding="{Binding Lokalizacja}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Background="#2e7d5e" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Dodaj" Command="{Binding PokazDodajFiliaCommand}"
                        Background="#4caf50" Foreground="White" Margin="3"
                        Padding="10,6" BorderThickness="0"/>
                <Button Content="✏️ Edytuj" Command="{Binding EdytujFiliaCommand}"
                        Background="#ff9800" Foreground="White" Margin="3"
                        Padding="10,6" BorderThickness="0"/>
                <Button Content="🗑️ Usuń" Command="{Binding UsunFiliaCommand}"
                        Background="#e53935" Foreground="White" Margin="3"
                        Padding="10,6" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>