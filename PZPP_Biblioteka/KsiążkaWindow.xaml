<Window x:Class="PZPP_Biblioteka.KsiążkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzaj Książkami" Height="640" Width="980">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#f5faf7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2e7d5e" Padding="15,10">
            <TextBlock Text="📚 Katalog Książek" Foreground="White"
                       FontSize="20" FontWeight="Bold"/>
        </Border>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Książki}"
                  SelectedItem="{Binding SelectedKsiążka, Mode=TwoWay}"
                  MouseDoubleClick="ListView_MouseDoubleClick"
                  Background="#f5faf7" BorderThickness="0"
                  Margin="10,10,10,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#c8e6d8"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#e0f2e9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8"
                            Margin="2,2" Padding="12,8"
                            BorderBrush="#d0e8db" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ISBN}"
                                       FontSize="11" Foreground="#888"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock Text="{Binding Tytuł}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="#1a3d2b"/>
                                <TextBlock Text="{Binding GatunekKsiążki.Nazwa}"
                                           FontStyle="Italic" Foreground="#2e7d5e"
                                           FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding IloscNaStanie, StringFormat='W filii: {0} szt.'}"
                                       VerticalAlignment="Center"
                                       Foreground="#2e7d5e" FontSize="12"
                                       FontWeight="SemiBold" Margin="5,0"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Autor.PełneNazwisko}"
                                       VerticalAlignment="Center"
                                       Foreground="#555" FontSize="12" Margin="5,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Background="#e8f5ee" Padding="15,6"
                BorderBrush="#c0ddd0" BorderThickness="0,1,0,0" Margin="10,5,10,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Łączna liczba egzemplarzy w katalogu: "
                           Foreground="#555" FontSize="13"/>
                <TextBlock Text="{Binding LiczbaEgzemplarzy}"
                           FontWeight="Bold" FontSize="13" Foreground="#2e7d5e"/>
                <TextBlock Text=" | Wybrana filia: "
                           Foreground="#555" FontSize="13" Margin="15,0,0,0"/>
                <TextBlock Text="{Binding WybranaFilia.Nazwa, FallbackValue='wszystkie'}"
                           FontWeight="Bold" FontSize="13" Foreground="#2e7d5e"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#2e7d5e" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏛️" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="150" Height="30"
                              ItemsSource="{Binding Filie}"
                              DisplayMemberPath="Nazwa"
                              SelectedItem="{Binding WybranaFilia, Mode=TwoWay}"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="🔍" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="180" Height="30"
                             Text="{Binding Wyszukaj, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ Dodaj" Command="{Binding PokazDodajKsiążkaCommand}"
                            Background="#4caf50" Foreground="White" Margin="3"/>
                    <Button Content="✏️ Edytuj" Command="{Binding EdytujKsiążkaCommand}"
                            Background="#ff9800" Foreground="White" Margin="3"/>
                    <Button Content="🗑️ Usuń" Command="{Binding UsunKsiążkaCommand}"
                            Background="#e53935" Foreground="White" Margin="3"/>
                    <Button Content="A→Z Sortuj" Command="{Binding SortujCommand}"
                            Background="#1565c0" Foreground="White" Margin="3"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>