<Window x:Class="PZPP_Biblioteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteka – System Zarządzania" Height="300" Width="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2e7d5e" Padding="20,15">
            <TextBlock Text="📚 System Zarządzania Biblioteką"
                       Foreground="White" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Orientation="Horizontal" Margin="20">
            <Button Content="📖 Gatunki"
                    Command="{Binding OpenGatunekWindowCommand}"
                    Width="150" Height="70" Margin="10"
                    Background="#64b5f6" Foreground="White"
                    FontSize="14" FontWeight="Bold" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#42a5f5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📚 Książki"
                    Command="{Binding OpenKsiążkaWindowCommand}"
                    Width="150" Height="70" Margin="10"
                    Background="#4caf50" Foreground="White"
                    FontSize="14" FontWeight="Bold" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#43a047"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="✍️ Autorzy"
                    Command="{Binding OpenAutorWindowCommand}"
                    Width="150" Height="70" Margin="10"
                    Background="#ffa726" Foreground="White"
                    FontSize="14" FontWeight="Bold" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#fb8c00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>