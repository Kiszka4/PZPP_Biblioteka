<Window x:Class="PZPP_Biblioteka.GatunekEdytujWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj Gatunek" Height="200" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#f0f7f4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2e7d5e" Padding="15,10">
            <TextBlock Text="✏️ Edytuj gatunek" Foreground="White"
                       FontSize="15" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="15,12">
            <Label Content="Nazwa gatunku:" Foreground="#1a3d2b" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SelectedGatunek.Nazwa, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,0" Padding="6,5"
                     BorderBrush="#b2d8c8" BorderThickness="1"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#2e7d5e" Padding="10,8">
            <Button Content="Zapisz zmiany" Command="{Binding ZapiszKategorieCommand}"
                    HorizontalAlignment="Right" Width="110" Height="30"
                    Background="#4caf50" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>